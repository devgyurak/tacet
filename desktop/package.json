{
  "name": "tacet-desktop",
  "productName": "Tacet",
  "version": "0.1.0",
  "private": true,
  "description": "Tacet(시험장 무선 기기 탐지기) 화면(Electron). 판정은 Rust 백엔드가 한다.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "electron . --demo",
    "test": "node --test \"test/*.test.js\"",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.tacet.desktop",
    "productName": "Tacet",
    "artifactName": "tacet-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../target/release/bundle"
    },
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "Contents/Resources/bin/*",
      "extendInfo": {
        "CFBundleDisplayName": "Tacet",
        "NSBluetoothAlwaysUsageDescription": "시험 중 교실에 나타난 휴대폰과 스마트 안경의 블루투스 신호를 받아 감독관에게 확인 필요 알림을 줍니다. macOS의 블루투스 스캔은 일반 기기와 같은 짧은 스캔 요청을 보낼 수 있습니다. 기기에 연결하거나 통신 내용을 읽지 않습니다.",
        "NSLocationWhenInUseUsageDescription": "macOS는 위치 권한이 있어야 주변 와이파이 기지국 주소를 알려 줍니다. 숨긴 핫스팟을 찾는 데만 쓰고 위치는 쓰지 않습니다."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Tacet",
      "uninstallDisplayName": "Tacet"
    }
  },
  "license": "SEE LICENSE IN LICENSE"
}
